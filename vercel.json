{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "header", "key": "sec-fetch-mode", "value": "navigate" }],
      "destination": "https://play.huwroberts.dev/solaris",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}
